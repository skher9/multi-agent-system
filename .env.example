# Copy the backend section into backend/.env and the web section into web/.env.local.
# Never put real values in this file: it is committed to git.

# ---------- backend/.env ----------

# Neon Postgres. Use the pooled connection string, with the psycopg driver prefix:
# postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
DATABASE_URL_TEST=

# Local Redis from docker-compose.yml
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (token scoped to one bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# GitHub: fine-grained token for the agent organization (contents + pull requests)
GITHUB_TOKEN=
GITHUB_ORG=

# Pusher Channels
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# OpenRouter: all model calls go through backend/llm_router
OPENROUTER_API_KEY=

# Jira Cloud: where tickets come from. Scoped API token from
# id.atlassian.com/manage-profile/security/api-tokens (read + write Jira work)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# v1 pipeline: the GitHub repo agents work on (owner/name) and its owner's email
AGENT_REPO=
AGENT_OWNER_EMAIL=

# ---------- web/.env.local ----------

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Login (Better Auth). The same Neon database as the backend, but in plain
# postgresql:// form (no +psycopg). Secret: 32+ random characters, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
