{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:api": "cd ../backend && uv run python -m api.export_openapi > ../web/src/lib/api/openapi.json && cd ../web && openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.1",
    "openapi-fetch": "^0.17.0",
    "pusher-js": "^8.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.30.1"
}
