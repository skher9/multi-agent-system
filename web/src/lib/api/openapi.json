  "components": {
    "schemas": {
      "EventOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "agent_run_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Run Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "data",
          "agent_run_id",
          "created_at"
        ],
        "title": "EventOut"
      },
      "GitHubConnect": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 400,
            "minLength": 10,
            "format": "password",
            "title": "Token",
            "writeOnly": true
          },
          "repo": {
            "type": "string",
            "maxLength": 200,
            "title": "Repo"
          }
        },
        "type": "object",
        "required": [
          "token",
          "repo"
        ],
        "title": "GitHubConnect"
      },
      "GitHubConnection": {
        "properties": {
          "login": {
            "type": "string",
            "title": "Login"
          },
          "repo": {
            "type": "string",
            "title": "Repo"
          },
          "connected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Connected At"
          }
        },
        "type": "object",
        "required": [
          "login",
          "repo",
          "connected_at"
        ],
        "title": "GitHubConnection"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthReport": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "services": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ServiceStatus"
            },
            "type": "object",
            "title": "Services"
          }
        },
        "type": "object",
        "required": [
          "status",
          "services"
        ],
        "title": "HealthReport"
      },
      "IntegrationKind": {
        "type": "string",
        "enum": [
          "jira",
          "github"
        ],
        "title": "IntegrationKind"
      },
      "JiraConnect": {
        "properties": {
          "site": {
            "type": "string",
            "maxLength": 200,
            "title": "Site"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email"
          },
          "api_token": {
            "type": "string",
            "maxLength": 400,
            "minLength": 10,
            "format": "password",
            "title": "Api Token",
            "writeOnly": true
          },
          "project_key": {
            "type": "string",
            "title": "Project Key"
          }
        },
        "type": "object",
        "required": [
          "site",
          "email",
          "api_token",
          "project_key"
        ],
        "title": "JiraConnect"
      },
      "JiraConnection": {
        "properties": {
          "site": {
            "type": "string",
            "title": "Site"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "project_key": {
            "type": "string",
            "title": "Project Key"
          },
          "connected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Connected At"
          }
        },
        "type": "object",
        "required": [
          "site",
          "email",
          "project_key",
          "connected_at"
        ],
        "title": "JiraConnection"
      },
      "JobStarted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          }
        },
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "JobStarted"
      },
      "JobStatus": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "STARTED",
              "RETRY",
              "FAILURE",
              "SUCCESS"
            ],
            "title": "Status"
          },
          "result": {
            "title": "Result"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "JobStatus"
      },
      "LearnRequest": {
        "properties": {
          "pr": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Pr",
            "description": "Pull request number in the agent's repo"
          }
        },
        "type": "object",
        "required": [
          "pr"
        ],
        "title": "LearnRequest"
      },
      "OwnProject": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "jira": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JiraConnection"
              },
              {
                "type": "null"
              }
            ]
          },
          "github": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GitHubConnection"
              },
              {
                "type": "null"
              }
            ]
          },
          "project_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready"
          }
        },
        "type": "object",
        "required": [
          "available",
          "jira",
          "github",
          "project_id",
          "ready"
        ],
        "title": "OwnProject"
      },
      "PlanDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "revise",
              "reject"
            ],
